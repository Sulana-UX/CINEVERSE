# CINEVERSE backend environment (never exposed to the browser)
PORT=5000
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP for OTP and ticket emails (use a Gmail App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="CINEVERSE Concierge <your-address@gmail.com>"

# Cloudinary signed uploads (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Supabase admin access (Dashboard > Settings > API > service_role). NEVER expose to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payments: "demo" (local test checkout, dev only) or "payhere"
PAYMENT_PROVIDER=demo
PAYHERE_MERCHANT_ID=your-merchant-id
PAYHERE_MERCHANT_SECRET=your-merchant-secret
PAYHERE_SANDBOX=true
# Public URL of this API (PayHere must reach /api/payments/payhere/notify)
PUBLIC_API_URL=https://api.example.com
FRONTEND_URL=http://localhost:5173
