# CINEVERSE frontend environment
# Everything prefixed with VITE_ is bundled into the browser: never put secrets here.

# Supabase (Dashboard > Settings > API): URL and anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary cloud name (public). Uploads are signed by the backend.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Optional: unsigned upload preset; when set, the backend signature is skipped
# VITE_CLOUDINARY_UPLOAD_PRESET=

# Backend API origin for production builds. Leave empty in development:
# the Vite dev server proxies /api to http://localhost:5000.
# VITE_API_URL=https://api.example.com
